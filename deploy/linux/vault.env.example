# systemd EnvironmentFile；安装为 /etc/vault/vault.env，权限 0600，root 所有。
# 不要在此文件保存 VAULT_ADMIN_PASSWORD 或任何数据库密码。
VAULT_ADDR=127.0.0.1:8080
VAULT_DATA_DIR=/var/lib/vault
VAULT_DATABASE=/var/lib/vault/vault.db
VAULT_BACKUP_ROOT=/var/lib/vault/backups
VAULT_MASTER_KEY_FILE=/var/lib/vault/key/master.key
VAULT_SESSION_TTL=12h
VAULT_SCHEDULER_INTERVAL=2s
VAULT_BACKUP_TIMEOUT=30m

# 按目标发行版实际安装的数据库客户端调整；缺失客户端会如实报告 prerequisite_missing。
VAULT_MYSQL=/usr/bin/mysql
VAULT_MYSQLDUMP=/usr/bin/mysqldump
VAULT_PSQL=/usr/bin/psql
VAULT_PG_BASEBACKUP=/usr/bin/pg_basebackup
VAULT_SQLCMD=/usr/bin/sqlcmd

# 若将 VAULT_BACKUP_ROOT 移到 /var/lib/vault 外，必须同时在 unit 中加入对应 ReadWritePaths。
