# systemd EnvironmentFile；安装为 /etc/dbbak/dbbak.env，权限 0600，root 所有。
# 不要在此文件保存 DBBAK_ADMIN_PASSWORD 或任何数据库密码。
DBBAK_ADDR=127.0.0.1:8080
DBBAK_DATA_DIR=/var/lib/dbbak
DBBAK_DATABASE=/var/lib/dbbak/dbbak.db
DBBAK_BACKUP_ROOT=/var/lib/dbbak/backups
DBBAK_MASTER_KEY_FILE=/var/lib/dbbak/key/master.key
DBBAK_SESSION_TTL=12h
DBBAK_SCHEDULER_INTERVAL=2s
DBBAK_BACKUP_TIMEOUT=30m

# 按目标发行版实际安装的数据库客户端调整；缺失客户端会如实报告 prerequisite_missing。
DBBAK_MYSQL=/usr/bin/mysql
DBBAK_MYSQLDUMP=/usr/bin/mysqldump
DBBAK_PSQL=/usr/bin/psql
DBBAK_PG_BASEBACKUP=/usr/bin/pg_basebackup
DBBAK_SQLCMD=/usr/bin/sqlcmd

# SQL Server 默认关闭任务创建；完成异名恢复验收后再取消注释并设为 1。
# DBBAK_SQLSERVER_ENABLED=1

# 若将 DBBAK_BACKUP_ROOT 移到 /var/lib/dbbak 外，必须同时在 unit 中加入对应 ReadWritePaths。
